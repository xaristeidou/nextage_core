<?xml version="1.0" ?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="aluminum_robot_base" params="prefix_base connected_to">
    <xacro:property name="M_PI" value="3.1415926535897931" />


        <link name="${prefix_base}base_link">
            <visual>
                <geometry>
                    <mesh filename="package://elux_screwing_robot_description/meshes/aluminum_robot_base.stl" scale="1 1 1" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0" />
                <material name="LightGrey">
                    <color rgba="0.75 0.75 0.75 1.0" />
                </material>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://elux_screwing_robot_description/meshes/aluminum_robot_base.stl" scale="1 1 1" />
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0 " />
            </collision>
        </link>

        <joint name="aluminum_base_joint" type="fixed">
            <origin xyz="0 0 0" rpy="0 0 0" />
            <parent link="${connected_to}" />
            <child link="${prefix_base}base_link" />
        </joint>

        <link name="robot_mount_link" />
        <joint name="robot_mount_joint" type="fixed">
            <origin xyz="0.166 -0.312 0.665" rpy="0 0 0" />
            <parent link="${prefix_base}base_link" />
            <child link="robot_mount_link" />
        </joint>


    </xacro:macro>
</robot>